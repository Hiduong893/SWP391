# Port chạy server Node.js (Render tự động set biến PORT)
PORT=5000

# Cấu hình Kết nối SQL Server Database (Ví dụ trên Azure SQL Database)
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_SERVER=your_azure_sql_server.database.windows.net
DB_DATABASE=CarRentalPlatform
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Secret cho xác thực Auth
JWT_SECRET=your_jwt_secret_key_here

# Client URL (Đường dẫn trang Frontend trên Vercel, ngăn chặn CORS)
CLIENT_URL=https://your-frontend-app.vercel.app

# API Keys cho dịch vụ tích hợp (Gemini AI, Open AI...)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Cấu hình Nodemailer gửi email
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
